#include <iostream>
#include <vector>
#include <queue>
#include <algorithm>

class Solution {
public:
    int findMaximizedCapital(int k, int w, std::vector<int>& profits, std::vector<int>& capital) {
        int n = profits.size();
        std::vector<std::pair<int, int>> projects(n);
        
        // 1. Group capital and profits together
        for (int i = 0; i < n; ++i) {
            projects[i] = {capital[i], profits[i]};
        }
        
        // 2. Sort projects based on minimum required capital ascendingly
        std::sort(projects.begin(), projects.end());
        
        // Max-heap to store profits of all affordable projects
        std::priority_queue<int> maxProfitHeap;
        int projectIdx = 0;
        
        // 3. Greedily pick up to k projects
        for (int i = 0; i < k; ++i) {
            // Push all projects that we can afford with our current capital 'w' into the max-heap
            while (projectIdx < n && projects[projectIdx].first <= w) {
                maxProfitHeap.push(projects[projectIdx].second);
                projectIdx++;
            }
            
            // If no projects are affordable, we cannot proceed further
            if (maxProfitHeap.empty()) {
                break;
            }
            
            // Pick the project with the highest profit
            w += maxProfitHeap.top();
            maxProfitHeap.pop();
        }
        
        return w;
    }
};
