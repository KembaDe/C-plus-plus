class Solution {
private:
    // Hash map to keep track of visited nodes and their clones
    unordered_map<Node*, Node*> visited;

public:
    Node* cloneGraph(Node* node) {
        // Base case: if the graph is empty
        if (node == nullptr) {
            return nullptr;
        }

        // If the node has already been cloned, return its clone
        if (visited.find(node) != visited.end()) {
            return visited[node];
        }

        // Create a new clone node with the same value
        Node* cloneNode = new Node(node->val);
        // Store it in the hash map before processing neighbors to handle cycles
        visited[node] = cloneNode;

        // Recursively clone all neighbors
        for (Node* neighbor : node->neighbors) {
            cloneNode->neighbors.push_back(cloneGraph(neighbor));
        }

        return cloneNode;
    }
};
